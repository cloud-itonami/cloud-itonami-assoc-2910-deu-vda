(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [association :string] :bool
  (string=? association "vda"))
(defn entry-count [association :string] :i64
  (if (association-covered? association) 2 0))
(defn valid-entry? [association :string index :i64] :bool
  (if (association-covered? association)
    (if (= index 0) true (if (= index 1) true false))
    false))

(defn entry-field [association :string index :i64 field :string]
  [:option :string]
  (if (valid-entry? association index)
    (if (= index 0)
      (cond
        (string=? field "id") (option-some-of [:option :string] "vda.code-of-conduct-business-partners")
        (string=? field "title") (option-some-of [:option :string] "Code of Conduct für Geschäftspartner (Code of Conduct for Business Partners), jointly with CLEPA")
        (string=? field "association") (option-some-of [:option :string] "vda")
        (string=? field "isic") (option-some-of [:option :string] "2910")
        (string=? field "country") (option-some-of [:option :string] "DEU")
        (string=? field "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? field "url") (option-some-of [:option :string] "https://www.vda.de/dam/jcr:4c19640b-b6fc-44bd-b633-01a2d317fc49/VDA-Leitfaden_Code-of-Conduct_Empfehlung.pdf")
        (string=? field "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? field "retrieved-at") (option-some-of [:option :string] "2026-07-15")
        :else (option-none-of [:option :string]))
      (cond
        (string=? field "id") (option-some-of [:option :string] "vda.about-organization")
        (string=? field "title") (option-some-of [:option :string] "About VDA (organization profile)")
        (string=? field "association") (option-some-of [:option :string] "vda")
        (string=? field "isic") (option-some-of [:option :string] "2910")
        (string=? field "country") (option-some-of [:option :string] "DEU")
        (string=? field "kind") (option-some-of [:option :string] "governance-program")
        (string=? field "url") (option-some-of [:option :string] "https://www.vda.de/en/association/about")
        (string=? field "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? field "established-date") (option-some-of [:option :string] "1901")
        (string=? field "retrieved-at") (option-some-of [:option :string] "2026-07-15")
        :else (option-none-of [:option :string])))
    (option-none-of [:option :string])))

(defn topic-count [association :string index :i64] :i64
  (if (valid-entry? association index) (if (= index 0) 2 1) 0))
(defn topic [association :string index :i64 topic-index :i64]
  [:option :string]
  (if (valid-entry? association index)
    (if (= index 0)
      (if (= topic-index 0) (option-some-of [:option :string] "human-rights")
          (if (= topic-index 1) (option-some-of [:option :string] "supply-chain")
              (option-none-of [:option :string])))
      (if (= topic-index 0) (option-some-of [:option :string] "governance")
          (option-none-of [:option :string])))
    (option-none-of [:option :string])))

(defn by-topic-count [association :string candidate :string] :i64
  (if (association-covered? association)
    (if (string=? candidate "human-rights") 1
        (if (string=? candidate "supply-chain") 1
            (if (string=? candidate "governance") 1 0))) 0))
(defn by-topic-id [association :string candidate :string index :i64]
  [:option :string]
  (if (association-covered? association)
    (if (= index 0)
      (if (string=? candidate "human-rights") (entry-field association 0 "id")
          (if (string=? candidate "supply-chain") (entry-field association 0 "id")
              (if (string=? candidate "governance") (entry-field association 1 "id")
                  (option-none-of [:option :string]))))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))
(defn coverage-note [association :string] [:option :string]
  (if (association-covered? association)
    (option-some-of [:option :string]
      "cloud-itonami-assoc-2910-deu-vda Wave 0 (ADR-2607141700): 2 vda entries seeded with official VDA citations. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))
(defn main [] :i64 0)
