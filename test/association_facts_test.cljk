(ns association-facts-test
  (:require [kotoba.bytes :as kbytes] [clojure.java.io :as io] [kotoba.process :as shell]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.compiler.core :as compiler] [kotoba.kir :as ir]))
(def source (slurp "src/association_facts.kotoba"))
(defn call [kir function & args] (ir/execute kir function (vec args)))
(defn present [option] (when (second option) (nth option 2)))
(def fields ["id" "title" "association" "isic" "country" "kind" "url"
             "url-provenance" "established-date" "retrieved-at"])
(def expected
  [{"id" "vda.code-of-conduct-business-partners"
    "title" "Code of Conduct für Geschäftspartner (Code of Conduct for Business Partners), jointly with CLEPA"
    "association" "vda" "isic" "2910" "country" "DEU" "kind" "self-regulatory-code"
    "url" "https://www.vda.de/dam/jcr:4c19640b-b6fc-44bd-b633-01a2d317fc49/VDA-Leitfaden_Code-of-Conduct_Empfehlung.pdf"
    "url-provenance" "official-association-site" "established-date" nil
    "retrieved-at" "2026-07-15"}
   {"id" "vda.about-organization" "title" "About VDA (organization profile)"
    "association" "vda" "isic" "2910" "country" "DEU" "kind" "governance-program"
    "url" "https://www.vda.de/en/association/about"
    "url-provenance" "official-association-site" "established-date" "1901"
    "retrieved-at" "2026-07-15"}])

(deftest reference-preserves-present-fields-absence-and-topics
  (let [kir (:kir (compiler/compile-source source :js-kotoba-v1))
        observed (mapv (fn [i] (into {} (map (fn [f] [f (present (call kir 'entry-field "vda" i f))]) fields))) [0 1])]
    (is (= expected observed))
    (is (= [nil "1901"] (mapv #(present (call kir 'entry-field "vda" % "established-date")) [0 1])))
    (is (= [2 1] (mapv #(call kir 'topic-count "vda" %) [0 1])))
    (is (= ["human-rights" "supply-chain"] (mapv #(present (call kir 'topic "vda" 0 %)) [0 1])))
    (is (= "vda.about-organization" (present (call kir 'by-topic-id "vda" "governance" 0))))
    (is (= #{} (set (:effects kir))))
    (testing "unknown values and invalid indexes fail closed"
      (is (zero? (call kir 'entry-count "clepa")))
      (is (nil? (present (call kir 'entry-field "vda" -1 "id"))))
      (is (nil? (present (call kir 'entry-field "vda" 2 "id"))))
      (is (nil? (present (call kir 'entry-field "vda" 0 "last-revised-date"))))
      (is (nil? (present (call kir 'topic "vda" 1 1))))
      (is (zero? (call kir 'by-topic-count "vda" "labor")))
      (is (nil? (present (call kir 'by-topic-id "vda" "governance" 1)))))))

(defn compiler-root []
  (nth (iterate #(.getParent ^java.nio.file.Path %)
                (java.nio.file.Path/of (.toURI (io/resource "kotoba/compiler/core.clj")))) 4))
(defn base64 [value] (kbytes/base64-encode value))
(deftest restricted-javascript-and-typed-wasm-conform-semantically
  (let [javascript (compiler/compile-source source :js-kotoba-v1)
        wasm (compiler/compile-source source :wasm32-browser-kotoba-v1)
        js64 (base64 (kbytes/utf8-bytes ^String (:source javascript))) wasm64 (base64 ^bytes (:bytes wasm))
        probe (shell/sh "node" "--input-type=module" "-e"
                (str "import(process.argv[1]).then(async host=>{const j=await import('data:text/javascript;base64," js64 "');"
                     "const w=await host.instantiateKotoba(Buffer.from(process.argv[2],'base64'));const run=x=>{"
                     "if(x['entry-count']('vda')!==2n||x['entry-field']('vda',0n,'established-date')[1]!==false||x['entry-field']('vda',1n,'established-date')[2]!=='1901')throw Error('dates');"
                     "if(x['topic-count']('vda',0n)!==2n||x['topic']('vda',0n,1n)[2]!=='supply-chain'||x['topic-count']('vda',1n)!==1n)throw Error('topics');"
                     "if(x['by-topic-id']('vda','governance',0n)[2]!=='vda.about-organization'||x['topic']('vda',1n,1n)[1]!==false)throw Error('query');};"
                     "run(j.instantiateKotoba({}));run(w.instance.exports);}).catch(e=>{console.error(e);process.exit(99)})")
                (.toString (.toUri (.resolve (compiler-root) "runtime/browser-host.mjs"))) wasm64)]
    (is (zero? (:exit probe)) (str (:out probe) (:err probe)))))
(deftest production-source-authority
  (is (= ["src/association_facts.kotoba"]
         (->> (file-seq (io/file "src")) (filter #(.isFile %)) (map str) sort vec))))
